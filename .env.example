NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:3000
# Exact CDN/reverse-proxy CIDRs; leave empty for direct-origin deployments.
TRUSTED_PROXY_CIDRS=
AUTH_ALLOWLIST_ENABLED=true
ALLOWED_EMAILS=marko@kortix.ai
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/whatsapp_gateway
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8080
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key
WORKER_ID=
WORKER_CAPACITY=25
LEASE_TTL_SECONDS=30
LEASE_HEARTBEAT_SECONDS=10
RECONNECT_STABLE_SECONDS=300
# Full device history sync on connect is heavy and raises WhatsApp automation flags; enable only if you need old messages.
SYNC_FULL_HISTORY=false
# Route the WhatsApp socket + media through a residential proxy so WhatsApp does not
# see a datacenter IP. Empty = direct. Supports http(s):// and socks5:// with credentials.
WA_PROXY_URL=
# Device profile shown in WhatsApp "Linked Devices": macos | windows | ubuntu. Keep it stable.
WA_BROWSER=macos
# Pin the WhatsApp Web version ("major,minor,patch"); empty auto-tracks the latest so it never goes stale.
WA_WEB_VERSION=
# Locale country in the login payload (2-letter). Empty = US. Set to the number's country, e.g. GB.
WA_COUNTRY_CODE=
# Native Android runtime provider. Leave disabled to run Baileys only.
ANDROID_RUNTIME_PROVIDER=disabled
PLATINUM_API_URL=https://api.platinum.dev
PLATINUM_TOKEN=
# Defaults identify the validated pre-enrollment Android 14 Google Play snapshot
# recorded in runtime/platinum/android-image.json. Override after publishing a
# replacement golden snapshot.
PLATINUM_ANDROID_SOURCE_SANDBOX_ID=sbx_01KYK6HNFFXRJR0ZGWZY6XR26C
PLATINUM_ANDROID_SNAPSHOT_ID=snap_01KYK7J4HP78S1T208KNQR395N
PLATINUM_ANDROID_CONTROL_PORT=8787
PLATINUM_ANDROID_NOVNC_PORT=6080
# Public is the current noVNC workaround; the desktop still requires the
# unique per-instance VNC password returned once by POST /v1/android/instances.
PLATINUM_ANDROID_NOVNC_PUBLIC=true
PLATINUM_ANDROID_BOOT_TIMEOUT_MS=240000
# Stable HTTP(S) residential proxy for the Android VM. When empty, an HTTP(S)
# WA_PROXY_URL is reused.
PLATINUM_ANDROID_PROXY_URL=
PLATINUM_ANDROID_APPIUM_REQUIRED=true
PAIRING_TTL_SECONDS=300
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_CONCURRENCY=10
ALLOW_PRIVATE_WEBHOOKS=false
ALLOW_INSECURE_DEVELOPMENT_DEFAULTS=false
